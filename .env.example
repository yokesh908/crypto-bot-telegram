# ============================================
# TELEGRAM SIGNAL BOT - API KEYS
# ============================================

# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef

# Bot username or channel ID to listen signals from
# Example: @nifty_signals or -1001234567890
TELEGRAM_CHANNEL=@your_signal_channel

# For cloud deployment (Render, Fly.io, etc.), generate a StringSession:
#   venv/bin/python telegram-bot/generate_string_session.py
# Then store it here instead of using telegram_session.session file.
TELEGRAM_STRING_SESSION=

# Telegram phone number (for one-time login, e.g. +919876543210)
PHONE_NUMBER=

# ============================================
# EXCHANGE API KEYS (Zerodha Kite / Angel One)
# ============================================

# Choose: zerodha / angel / groww / paper
EXCHANGE_PROVIDER=paper

# Zerodha Kite Connect (https://developers.kite.trade)
# Get access token automatically with:
#   venv/bin/python telegram-bot/zerodha_login.py
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=
KITE_TOTP_SECRET=your_totp_secret  # optional, if TOTP 2FA is enabled on your account

# Angel One SmartAPI (https://smartapi.angelone.in)
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_angel_client_id
ANGEL_PASSWORD=your_angel_password
ANGEL_TOTP_SECRET=your_angel_totp_secret

# ============================================
# TRADING CONFIG
# ============================================

# Capital per trade in INR
TRADE_CAPITAL_INR=30000

# Paper or real
MODE=paper

# Default SL percentage if not mentioned in signal
DEFAULT_SL_PERCENT=2.0

# --- ENHANCED SL: profit with less risk ---
MAX_SL_PERCENT=25
MAX_SL_POINTS=12
MIN_SL_POINTS=5
BREAKEVEN_AT_T1=1
TRAIL_TO_T1_AT_T2=1
MAX_RISK_PER_TRADE_INR=3000

# Target preference order: T2 > T3 > T1
TARGET_PRIORITY=T3,T2,T1
